# ---------------------------------------------------------------------------
# [A-FIX-3] Fallback migliorato
# ---------------------------------------------------------------------------
def _fallback_answer(image_path: str, question: str,
                     intermediate_steps: list) -> str:
    """
    Chiamato quando l'agente non ha dato risposta.
    Raccoglie le observation di tool_leggi_wikipedia (non più tool_leggi_pagina_intera).
    """
    context_parts = []
    for action, observation in (intermediate_steps or []):
        tool_name = getattr(action, "tool", "")
        if tool_name == "tool_leggi_wikipedia":
            obs_str = str(observation)
            # Escludiamo i messaggi di errore/sistema
            if not obs_str.startswith(("ERROR:", "CRITICAL ERROR:", "⚠️")):
                context_parts.append(obs_str[:3000])

    if not context_parts:
        messages = [{"role": "user", "content": [
            {"type": "image", "image": image_path},
            {"type": "text",  "text": f"Answer this question briefly: {question}"}
        ]}]
    else:
        context = "\n\n---\n\n".join(context_parts)[:8000]
        messages = [{"role": "user", "content": [
            {"type": "image", "image": image_path},
            {"type": "text",  "text": (
                f"Based on this Wikipedia context:\n{context}\n\n"
                f"Answer briefly and factually: {question}\n"
                f"Give only the answer, no preamble."
            )}
        ]}]

    try:
        return generate_answer(
            tools_real.qwen_model, tools_real.qwen_processor,
            messages, max_new_tokens=128,
        )
    except Exception:
        return ""

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def _clean_answer(answer: str) -> str:
    answer = answer.strip()
    for pat in [
        r"^(based on (the )?(retrieved|wikipedia|available) (context|information|text)[,.]?\s*)",
        r"^(according to (the )?(wikipedia|context|text)[,.]?\s*)",
        r"^(the answer is:?\s*)",
        r"^(therefore[,.]?\s*)",
        r"^(from the (wikipedia|context)[,.]?\s*)",
    ]:
        answer = re.sub(pat, "", answer, flags=re.IGNORECASE).strip()
    return answer

def _summarize_steps(steps, logged_urls: list, read_urls: list) -> dict:
    """
    [A-FIX-1] Usa get_logged_urls() e get_read_urls() invece di parse_retrieved_urls
    sulle stringhe delle observation (che non catturava nulla).
    """
    tool_calls, observations = [], []
    for action, observation in (steps or []):
        tool_calls.append({
            "tool": getattr(action, "tool", None),
            "tool_input": str(getattr(action, "tool_input", None)),
        })
        observations.append(str(observation))

    return {
        "tool_calls": tool_calls,
        "candidate_urls": logged_urls,       # [A-FIX-2] top-5 proposti
        "read_urls": read_urls,              # [A-FIX-2] effettivamente letti
        "retrieved_urls": read_urls,         # manteniamo compatibilità col campo storico
        "num_tool_calls": len(tool_calls),
        "observations_tokens_est": token_estimate("\n".join(observations)),
    }

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def run_agentic_rag(image_path, question, question_id=None,
                    ground_truth="", question_type="unknown",
                    expected_sources=None):

    reset_query_state()
    set_current_question(question)
    vero_qwen.current_image_path = image_path

    start  = now_seconds()
    result = {}
    answer = ""
    error  = None

    try:
        comando = (
            f"[IMG]{image_path}[/IMG]\n"
            f"Question: {question}\n"
            f"Image Path: {image_path}\n"
        )
        result = esecutore.invoke({"input": comando})
        answer = result.get("output", "")

        if not answer or "Agent stopped" in answer or "iteration limit" in answer:
            answer = _fallback_answer(
                image_path, question,
                result.get("intermediate_steps", [])
            )

        answer = _clean_answer(answer)

    except Exception as e:
        error  = str(e)
        answer = _fallback_answer(image_path, question,
                                  result.get("intermediate_steps", []))

    # [A-FIX-1] Leggi URL dallo stato thread-local (sempre aggiornati)
    logged_urls = get_logged_urls()
    read_urls   = get_read_urls()

    step_info   = _summarize_steps(
        result.get("intermediate_steps", []),
        logged_urls=logged_urls,
        read_urls=read_urls,
    )
    ret_metrics = retrieval_metrics(
        step_info.get("read_urls", []),
        expected_sources or [],
        k=args.top_k,
    )

    return build_common_record(
        question_id=question_id,
        model_name="agentic_rag_v4",
        image_path=image_path,
        question=question,
        ground_truth=ground_truth,
        answer=answer,
        question_type=question_type,
        latency_seconds=elapsed(start),
        error=error,
        extra={
            "num_steps": step_info["num_tool_calls"],
            **step_info,
            **ret_metrics,
        },
    )

